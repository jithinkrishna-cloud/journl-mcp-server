# Copy to plugin/plugin.env and fill in, then run: npm run build:plugin
# All URLs must be public HTTPS pages that identify the same publisher as the OpenAI submission.

# Stable production MCP endpoint (not ngrok).
MCP_URL=https://mcp.journl.in/mcp

# Listing pages (all four are required for MCP review).
WEBSITE_URL=https://journl.in
SUPPORT_URL=https://journl.in/support
PRIVACY_URL=https://journl.in/privacy
TERMS_URL=https://journl.in/terms
SUPPORT_EMAIL=support@journl.in

# Reviewer-accessible video walkthrough of the 5 positive and 3 negative test cases.
DEMO_VIDEO_URL=https://

# Optional overrides.
# DEVELOPER_NAME=Bizpole
# CATEGORY=Finance
# PLUGIN_VERSION=1.0.0
# RELEASE_NOTES=Initial release: read-only JournL accounting reports in ChatGPT.
