{
  "name": "journl-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only MCP server that lets ChatGPT query JournL accounting data through JournL's existing APIs",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "verify": "node --env-file-if-exists=.env scripts/verify-account.js",
    "build:plugin": "node --env-file-if-exists=plugin/plugin.env scripts/build-plugin.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
