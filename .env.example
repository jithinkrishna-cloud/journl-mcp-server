# Public HTTPS base URL ChatGPT uses to reach this server (tunnel or domain), no trailing slash.
PUBLIC_URL=http://localhost:3100
PORT=3100

# JournL backend API. Use the test API until production is approved.
JOURNL_API_BASE_URL=https://testapi.bizpolebooks.com
# Timeout for each JournL API call (ms).
JOURNL_TIMEOUT_MS=30000

# Shown on the sign-in page; required for a public ChatGPT listing.
PRIVACY_POLICY_URL=

# Where registered OAuth clients are kept (not tokens, not accounting data).
CLIENTS_FILE=data/clients.json

# OAuth redirect URIs are limited to ChatGPT callbacks. Add exact extra URIs here
# (comma-separated) only for local testing, e.g. MCP Inspector. Leave empty in production.
OAUTH_EXTRA_REDIRECT_URIS=

# Rate limits and timeouts.
LOGIN_FAILURE_LIMIT=10
MCP_REQUESTS_PER_MINUTE=120
HTTP_REQUEST_TIMEOUT_MS=60000

# Domain-verification token shown in the OpenAI plugin portal (Connect MCP server).
OPENAI_APPS_CHALLENGE=
